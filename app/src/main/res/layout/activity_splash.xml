<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_marca">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp">

        <ImageView
            android:id="@+id/simbolo"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:contentDescription="@string/desc_logo"
            android:src="@drawable/simbolo_nexcode" />

        <TextView
            android:id="@+id/marca"
            style="@style/Texto.Marca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/marca" />

        <TextView
            android:id="@+id/marcaSecundaria"
            style="@style/Texto.MarcaSecundaria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/marca_secundaria" />

        <TextView
            android:id="@+id/lema"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:alpha="0.85"
            android:gravity="center"
            android:text="@string/lema"
            android:textColor="@color/nex_texto_sobre_marca"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progreso"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="72dp"
        android:indeterminate="true"
        app:indicatorColor="@color/nex_verde"
        app:trackColor="@color/nex_blanco_20"
        app:trackCornerRadius="3dp"
        app:trackThickness="4dp" />

</FrameLayout>
