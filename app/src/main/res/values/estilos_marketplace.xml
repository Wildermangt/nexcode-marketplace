<?xml version="1.0" encoding="utf-8"?>
<!--
    Estilos propios del marketplace. Los generales (textos, botones, tarjetas,
    campos, chips) se heredaron de NEXCODE Banca y viven en estilos.xml.
-->
<resources>

    <!-- Fila de una lista de opciones: icono, texto y flecha. -->
    <style name="FilaOpcion">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/fondo_pulsable</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="TextoOpcion">
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:textColor">@color/nex_texto</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--
        Boton de un grupo segmentado (entrar / crear cuenta, nuevo / usado).
        El estilo "Tecla" que se heredo del banco era el del teclado numerico,
        con letra de 26 sp; aqui hace falta un texto normal.
    -->
    <style name="Segmento" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/segmento_texto</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="backgroundTint">@color/segmento_fondo</item>
        <item name="strokeColor">@color/nex_borde</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/radio_control</item>
        <item name="rippleColor">@color/nex_azul_12</item>
        <item name="iconTint">@color/segmento_texto</item>
    </style>

    <!-- Tarjeta de metrica del panel del vendedor. -->
    <style name="MetricaPanel" parent="Tarjeta">
        <item name="cardCornerRadius">22dp</item>
    </style>

</resources>
