<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o superior: ni la nube ni la transferencia entre teléfonos se
     llevan la sesión ni la copia SQLite. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesion_nexcode.xml" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesion_nexcode.xml" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
