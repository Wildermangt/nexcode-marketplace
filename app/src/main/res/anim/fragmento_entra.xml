<?xml version="1.0" encoding="utf-8"?>
<!-- Transicion de tipo "fade through" entre secciones -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0"
        android:startOffset="90" android:duration="220" />
    <scale
        android:fromXScale="0.94" android:toXScale="1.0"
        android:fromYScale="0.94" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%"
        android:startOffset="90" android:duration="260" />
</set>